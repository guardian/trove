{
	"name": "trove-listener",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --external:@aws-sdk/* --outfile=dist/index.js",
		"package": "npm run build && cd dist && rm -f trove-listener.zip && zip trove-listener.zip index.js",
		"test": "node --test 'src/**/*.test.ts'",
		"typecheck": "tsc --noEmit",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@types/aws-lambda": "8.10.164",
		"esbuild": "0.28.2"
	},
	"dependencies": {
		"@guardian/content-api-models": "53.0.0"
	}
}
