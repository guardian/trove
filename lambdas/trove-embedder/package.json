{
	"name": "trove-embedder",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --external:@aws-sdk/* --outfile=dist/index.js",
		"package": "npm run build && cd dist && rm -f trove-embedder.zip && zip trove-embedder.zip index.js",
		"test": "node --test 'src/**/*.test.ts'",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"invoke-local": "node scripts/invoke-local.ts"
	},
	"devDependencies": {
		"@types/aws-lambda": "8.10.164",
		"esbuild": "0.28.2"
	},
	"dependencies": {
		"@aws-sdk/client-bedrock-runtime": "3.1167.0",
		"datastore": "0.0.0",
		"shared": "0.0.0",
		"zod": "4.6.7"
	}
}
