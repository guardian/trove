{
	"name": "trove-api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --external:@aws-sdk/* --outfile=dist/index.js",
		"package": "npm run build && cd dist && rm -f trove-api.zip && zip trove-api.zip index.js",
		"test": "node --test 'src/**/*.test.ts'",
		"typecheck": "tsc --noEmit",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@types/aws-lambda": "8.10.164",
		"esbuild": "0.28.2"
	},
	"dependencies": {
		"@types/express": "5.0.6",
		"express": "5.3.0",
		"serverless-http": "4.0.0"
	}
}
