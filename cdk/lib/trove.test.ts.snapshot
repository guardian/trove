omise((resolve) => setTimeout(resolve, pollIntervalMs));\\n\\t}\\n\\n\\treturn respond(\\n\\t\\t'FAILED',\\n\\t\\t\`\${Url} did not report healthy build \${ExpectedBuildId} within \${TimeoutSeconds}s. Last result: \${lastResult}\`,\\n\\t);\\n})(event);"
        },
