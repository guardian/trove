{
	"name": "cdk",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "node --test 'lib/**/*.test.ts'",
		"test-update": "node --test --test-update-snapshots 'lib/**/*.test.ts'",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"{lib,bin}/**/*.ts\"",
		"lint": "eslint .",
		"synth": "cdk synth --path-metadata false --version-reporting false",
		"diff": "cdk diff --path-metadata false --version-reporting false"
	},
	"devDependencies": {
		"@guardian/cdk": "66.0.0",
		"aws-cdk": "2.1135.0",
		"aws-cdk-lib": "2.263.0",
		"constructs": "10.8.1"
	}
}
