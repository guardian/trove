{
	"name": "trove",
	"description": "Vector search for Guardian articles",
	"homepage": "https://github.com/guardian/trove#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/guardian/trove.git"
	},
	"author": "Newsroom AI",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^26.0.0"
	},
	"workspaces": [
		"cdk",
		"libs/datastore",
		"libs/shared",
		"lambdas/trove-backfill",
		"lambdas/trove-embedder",
		"lambdas/trove-listener"
	],
	"scripts": {
		"test": "npm test --workspaces",
		"typecheck": "npm run typecheck --workspaces",
		"lint:fix": "node ./scripts/check-packages-are-of-type-module.mjs && eslint . --fix",
		"lint:check": "node ./scripts/check-packages-are-of-type-module.mjs && eslint .",
		"format:fix": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@guardian/eslint-config": "16.0.0",
		"@guardian/prettier": "5.0.0",
		"@guardian/tsconfig": "2.0.0",
		"@types/node": "26.6.4",
		"eslint": "9.39.2",
		"globals": "17.4.0",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"overrideNotes": {
		"@guardian/eslint-config": "v16 pins typescript-eslint 8.59.3 and eslint-plugin-import-x 4.16.2, which only allow minimatch versions vulnerable to GHSA-g3hv-75wg-m249. Remove once @guardian/eslint-config pins fixed versions.",
		"@guardian/story-packages-model": "Depends on thrift ^0.15.0, which is vulnerable (GHSA-r67j-r569-jrwp, GHSA-526f-jxpj-jmg2). Pulled in via @guardian/content-api-models. Remove once story-packages-model depends on thrift >=0.23.0."
	},
	"overrides": {
		"@guardian/eslint-config": {
			"eslint-plugin-import-x": "4.18.1",
			"typescript-eslint": "8.73.0"
		},
		"@guardian/story-packages-model": {
			"thrift": "0.23.0"
		}
	},
	"prettier": "@guardian/prettier"
}
